# OpenAI-compatible local LLM server
LLM_BASE_URL=http://localhost:8081
LLM_MODEL=gemma-4-12b-it.Q4_K_M.gguf
LLM_TIMEOUT=300

# GPU admission control: one T4 / llama.cpp -np 5
AI_MAX_CONCURRENT_REQUESTS=5
AI_MAX_QUEUED_REQUESTS=10
AI_QUEUE_WAIT_TIMEOUT_SECONDS=40
AI_ADMISSION_LOG_PATH=/var/log/cineverse/ai-admission.log

# Topic grounding: reviewed profiles and privacy-minimal learning candidates
TOPIC_PROFILE_PATH=/home/ubuntu/cineverse/data/topic_profiles.json
TOPIC_LEARNING_LOG_PATH=/var/log/cineverse/topic-learning.jsonl
DIALOGUE_GUARD_LOG_PATH=/var/log/cineverse/dialogue-guard.jsonl

# Required only for Hugging Face model download/training
HF_TOKEN=
AI_SYNC_TOKEN=replace-with-shared-random-sync-token
MOVIE_COLLECTION_NAME=movies_active
CHARACTER_COLLECTION_NAME=characters_verified_v5
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530

# Optional external web search. Free Tavily plan: 1,000 credits/month.
TAVILY_API_KEY=
WEB_SEARCH_MONTHLY_LIMIT=950
WEB_SEARCH_WARNING_AT=900
WEB_SEARCH_CACHE_TTL_SECONDS=21600
WEB_SEARCH_TIMEOUT_SECONDS=12
WEB_SEARCH_USAGE_DB=/home/ubuntu/cineverse/data/web_search_usage.sqlite3
