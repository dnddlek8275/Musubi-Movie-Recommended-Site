# Database
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/cineverse
SQL_ECHO=false

# TMDB (Access Token 권장, 없으면 v3 API Key 사용)
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
TMDB_SYNC_MIN_RATING=6.0
TMDB_SYNC_MIN_VOTES=100
TMDB_SYNC_DISCOVER_MAX_PAGES=20
TMDB_SYNC_FETCH_CONCURRENCY=5

# KOBIS daily box office (https://kobis.or.kr/kobisopenapi/)
KOBIS_API_KEY=
KOBIS_TIMEOUT_SECONDS=15

# JWT
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_COOKIE_PATH=/auth
REFRESH_COOKIE_SECURE=false

# AI service
AI_BASE_URL=http://localhost:8001
AI_CHAT_TIMEOUT_SECONDS=60
AI_SYNC_TOKEN=
AI_SYNC_TIMEOUT_SECONDS=180

# KakaoCloud Object Storage (S3 compatible)
OBJECT_STORAGE_ENDPOINT=https://objectstorage.kr-central-2.kakaocloud.com
OBJECT_STORAGE_REGION=kr-central-2
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Public bucket/CDN URL이 있으면 설정. 비워두면 presigned URL을 반환합니다.
OBJECT_STORAGE_PUBLIC_BASE_URL=
OBJECT_STORAGE_PROFILE_PREFIX=assets/profiles/user
OBJECT_STORAGE_PRESIGN_EXPIRES_SECONDS=3600
GUEST_CHAT_DAILY_LIMIT=10
AUTH_RATE_LIMIT_TRUST_PROXY_HEADERS=false
LOGIN_FAILURE_LIMIT=10
LOGIN_FAILURE_WINDOW_MINUTES=15
EMAIL_REQUEST_LIMIT_PER_HOUR=5
AUTH_IP_REQUEST_LIMIT_PER_HOUR=20
GUEST_CHAT_MAX_CONCURRENCY=4
# ALB/Ingress가 클라이언트의 직접 접속 경로일 때만 true로 설정
GUEST_CHAT_TRUST_PROXY_HEADERS=false

# Browser origins allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email verification
EMAIL_VERIFICATION_EXPIRE_MINUTES=5
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# SMTP (for Gmail, use an app password rather than your account password)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-email@example.com

# Password reset
FRONTEND_BASE_URL=http://localhost:5173
PASSWORD_RESET_EXPIRE_MINUTES=30
